# Backend NestJS (backend/) — nơi xử lý toàn bộ đăng nhập/phân quyền. Next chuyển tiếp /api/v1/* sang đây.
BACKEND_URL=http://localhost:4000

# Fallback dữ liệu căn mẫu khi backend lỗi (5xx/timeout/mạng). Mặc định false; production LUÔN tắt dù đặt true.
# Bật chỉ để dựng giao diện khi không có backend: dữ liệu hiện kèm banner "Dữ liệu mẫu" và source: "mock".
ALLOW_MOCK_FALLBACK=false
