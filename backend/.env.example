# ========================================================
# VINSTAY AI BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server
NODE_ENV=development
# 4000 để không đụng cổng dev của Next.js (apps/web chạy :3000)
PORT=4000
API_PREFIX=api/v1

# Web app (apps/web) — dùng cho redirect sau đăng nhập Google / email xác nhận và CORS
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Sau Next proxy (/api/v1 rewrite) đặt 1 để rate limit/audit thấy IP thật; để trống nếu backend lộ trực tiếp
TRUST_PROXY=1
# Cookie phiên: mặc định Secure khi NODE_ENV=production. COOKIE_DOMAIN chỉ cần khi FE/BE khác subdomain
# COOKIE_SECURE=
# COOKIE_DOMAIN=

# Đăng nhập Google (Passport, KHÔNG qua Supabase). Tạo OAuth client "Web application" ở Google Cloud Console
# (APIs & Services → Credentials) và thêm GOOGLE_CALLBACK_URL vào "Authorized redirect URIs" — phải khớp từng ký tự.
# Để trống thì endpoint /auth/google trả 503 auth_not_configured (backend vẫn khởi động).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mặc định: ${WEB_APP_URL}/${API_PREFIX}/auth/google/callback (đi qua rewrite của Next để cookie cùng origin với FE)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# OTP (Zalo ZNS → SMS fallback). Không có nhà cung cấp thật thì API từ chối gửi OTP.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_SECONDS=600
OTP_RESEND_SECONDS=60

# Supabase: chỉ còn dùng cho Postgres (DATABASE_URL) + Storage ảnh hồ sơ ký gửi. Đăng nhập KHÔNG qua Supabase Auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vinstay_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vinstay_db?schema=public"

# Redis Cache & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption
# Khoá ký JWT phiên của đăng nhập Google. Production BẮT BUỘC, >= 32 ký tự: openssl rand -base64 48
# (dev để trống thì dùng khoá dẫn xuất từ AES_SECRET_KEY). Đổi khoá = mọi phiên Google đang đăng nhập bị đăng xuất.
JWT_SECRET=
AES_SECRET_KEY=vinstay_aes_256_secret_key_vhop_32bytes!
VAULT_KEY_PREFIX=vinstay:vault:keys:

# External providers. Leave empty until real provider credentials and callback are configured.
FPT_EKYC_API_KEY=
VIETQR_BANK_ID=
VIETQR_BANK_NAME=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_WEBHOOK_SECRET=
ZALO_OA_ACCESS_TOKEN=

# Trợ lý AI (relay tới ai-engine). Thiếu AI_ENGINE_URL ⇒ POST /assistant/chat trả 503 AI_UPSTREAM_DOWN, web rơi về bộ lọc cũ.
# Khách chưa đăng nhập: số lượt chat được chấp nhận / IP / 24h (mặc định 2); lượt sau ⇒ 401 LOGIN_REQUIRED.
# ASSISTANT_GUEST_TURNS=2
AI_ENGINE_URL=
AI_ENGINE_INTERNAL_KEY=
